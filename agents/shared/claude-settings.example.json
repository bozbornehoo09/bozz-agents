{
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -xdf *)",
      "Bash(git branch -D *)",
      "Bash(terraform destroy *)",
      "Bash(kubectl delete *)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr ready *)"
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I /ABSOLUTE/PATH/TO/bozz-agents/agents/shared/shell_deny.py --family destructive"
          }
        ]
      }
    ]
  },
  "env": {
    "BOZZ_CTXCAP_WORKER_K": "350",
    "BOZZ_CTXCAP_MANAGER_K": "150",
    "BOZZ_CTXCAP_BARE": "0"
  }
}
